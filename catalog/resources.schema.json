{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MMrk36/ps-base/main/catalog/resources.schema.json",
  "title": "Pedro Scripts Resource Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "resources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogVersion": {
      "type": "string",
      "minLength": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "resources"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" }
            }
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "repository",
        "submodulePath",
        "status",
        "installable",
        "releases"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "submodulePath": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "development",
            "preview",
            "stable",
            "deprecated"
          ]
        },
        "installable": {
          "type": "boolean"
        },
        "releases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/release"
          }
        },
        "preservePaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "filePolicies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default": { "enum": ["managed", "preserve", "replace"] },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pattern", "policy"],
                "properties": {
                  "pattern": { "type": "string", "minLength": 1 },
                  "policy": { "enum": ["managed", "preserve", "replace"] }
                }
              }
            }
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "tag",
        "asset",
        "url",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "apiVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "psCoreApi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
            "maxVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" }
          },
          "anyOf": [
            { "required": ["minVersion"] },
            { "required": ["maxVersion"] }
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optionalDependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minimumArtifact": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$"
        },
        "migrationNotice": {
          "type": "string"
        },
        "releaseNotes": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      }
    }
  }
}
