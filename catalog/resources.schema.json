{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MMrk36/ps-base/main/catalog/resources.schema.json",
  "title": "Pedro Scripts Resource Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "resources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogVersion": {
      "type": "string",
      "minLength": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "repository",
        "submodulePath",
        "status",
        "installable",
        "releases"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "submodulePath": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "development",
            "preview",
            "stable",
            "deprecated"
          ]
        },
        "installable": {
          "type": "boolean"
        },
        "releases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/release"
          }
        },
        "preservePaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "tag",
        "asset",
        "url",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "psCoreApi": {
          "type": "object"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optionalDependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minimumArtifact": {
          "type": "string"
        },
        "migrationNotice": {
          "type": "string"
        },
        "releaseNotes": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      }
    }
  }
}
